# Public Supabase values are safe to expose to the browser; Row Level Security
# must still protect every exposed table. Never add service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use a Supabase secret key in deployed server environments;
# never prefix it with NEXT_PUBLIC_ or commit a value to this repository.
SUPABASE_SECRET_KEY=
